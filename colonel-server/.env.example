# Copy these into Railway → your service → Variables.
# Only ANTHROPIC_API_KEY is required; the rest have sensible defaults.

# REQUIRED — your Anthropic API key (keep secret; never commit it)
ANTHROPIC_API_KEY=sk-ant-...

# Hard daily spend cap in USD (default 0.01)
DAILY_CAP_USD=0.01

# Model (default claude-haiku-4-5 — keeps the $0.01 cap usable)
COLONEL_MODEL=claude-haiku-4-5

# Max tokens the Colonel may speak per reply (default 320)
MAX_OUTPUT_TOKENS=320

# CORS: restrict to your site's origin in production, e.g.
#   https://dkgaddy.github.io   or   https://savoytexas.org
# Use * only for quick testing.
ALLOWED_ORIGIN=*

# Persist the daily-spend counter across restarts by pointing this at a
# Railway Volume mount path. If you attach a volume at /data, set:
#   SPEND_FILE=/data/spend.json
# Without a volume it writes locally and resets on redeploy (which only
# ever resets the budget early — it cannot overspend).
# SPEND_FILE=/data/spend.json
